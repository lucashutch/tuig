# Run palette entries one at a time and check the screen after each: focus, tabs, panels, avatars,
# remote commands with no remote, and the entries that need a GitHub remote.
fixture demo
extra second
wait text "Working Changes"
key ctrl+p
text "Focus changed files"
key enter
snapshot focus-files
key ctrl+p
text "Focus commit history"
key enter
snapshot focus-history
key ctrl+p
text "Next repository tab"
snapshot next-tab-single
key esc
key ctrl+p
text "Open new repository tab"
key enter
snapshot new-tab
text "{second}"
key enter
wait text "docs: extend notes"
snapshot second-open
key ctrl+p
text "Previous repository tab"
key enter
snapshot previous-tab
key ctrl+p
text "Next repository tab"
key enter
snapshot next-tab
key ctrl+p
text "Close current repository tab"
key enter
snapshot close-tab
key ctrl+p
text "Filter and checkout branches"
key enter
snapshot filter
key esc
key ctrl+p
text "Refresh repository"
key enter
snapshot refresh
key ctrl+p
text "Fetch remotes"
snapshot fetch-no-remote
key enter
snapshot fetch-run
key ctrl+p
text "Pull current branch"
snapshot pull-no-upstream
key esc
key ctrl+p
text "Push current branch"
snapshot push-no-upstream
key esc
key ctrl+p
text "Refresh pull requests"
snapshot refresh-prs
key esc
key ctrl+p
text "Open pull request for current branch"
snapshot open-pr
key esc
key ctrl+p
text "Collapse left panel"
key enter
snapshot left-collapsed
key ctrl+p
text "Expand left panel"
key enter
snapshot left-expanded
key ctrl+p
text "Collapse right panel"
key enter
snapshot right-collapsed
key ctrl+p
text "Expand right panel"
key enter
snapshot right-expanded
key ctrl+p
text "Disable author avatars"
key enter
snapshot avatars-off
key ctrl+p
text "Enable author avatars"
key enter
snapshot avatars-on
# Rust shows a notice at the right of the footer, and it stays 6 s. The notice is reported by the avatars snapshots.
mask 125 47 35 1
key ctrl+p
text "Compose commit"
key enter
# The Staged heading repaints late in TS while the composer takes focus (flaky), so mask it.
mask 140 19 20 1
snapshot compose
