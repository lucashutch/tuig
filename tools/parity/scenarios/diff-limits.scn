# A diff of about 24,000 lines opens without syntax highlight. A diff of about 6 MiB is not loaded:
# the app says so, and Shift+L loads it without highlight.
fixture bigdiff
wait text "Working Changes"
click 60 4
wait text "Unstaged files"
click 126 7
wait text "v0 = 0"
snapshot lines-no-highlight
click 126 6
wait text "Diff exceeds 5 MiB"
snapshot too-large
key L
wait text "value_000000"
snapshot loaded-after-shift-l
click 126 8
wait text "s0 = 0"
snapshot rewritten-small-file
