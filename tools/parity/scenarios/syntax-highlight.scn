# Select one commit per language and read the diff. Each snapshot has syntax colors.
# The wait text is a line from that language's sample file.
fixture history
# The footer shows a message for 6 s after a commit click, so its text depends on timing.
mask 0 47 160 1
quiet 600
wait text "add md sample"
click 60 4
wait text "COMMIT FILES"
click 118 18
wait text "make task-"
snapshot md
key esc
wait text "Branch / tag"
click 60 5
wait text "COMMIT FILES"
click 118 18
wait text "<h1 id"
snapshot html
key esc
wait text "Branch / tag"
click 60 6
wait text "COMMIT FILES"
click 118 18
wait text ".task-"
snapshot css
key esc
wait text "Branch / tag"
click 60 7
wait text "COMMIT FILES"
click 118 18
wait text "namespace tasks"
snapshot cpp
key esc
wait text "Branch / tag"
click 60 8
wait text "COMMIT FILES"
click 118 18
wait text "<stdio.h>"
snapshot c
key esc
wait text "Branch / tag"
click 60 9
wait text "COMMIT FILES"
click 118 18
wait text "run_task_"
snapshot sh
key esc
wait text "Branch / tag"
click 60 10
wait text "COMMIT FILES"
click 118 18
wait text ""limits""
snapshot json
key esc
wait text "Branch / tag"
click 60 11
wait text "COMMIT FILES"
click 118 18
wait text "module.exports"
snapshot js
key esc
wait text "Branch / tag"
click 60 12
wait text "COMMIT FILES"
click 118 18
wait text "className"
snapshot tsx
key esc
wait text "Branch / tag"
click 60 13
wait text "COMMIT FILES"
click 118 18
wait text "makeTask"
snapshot ts
key esc
wait text "Branch / tag"
click 60 14
wait text "COMMIT FILES"
click 118 18
wait text "HashMap"
snapshot rs
key esc
wait text "Branch / tag"
click 60 15
wait text "COMMIT FILES"
click 118 18
wait text "package main"
snapshot go
key esc
wait text "Branch / tag"
click 60 16
wait text "COMMIT FILES"
click 118 18
wait text "def run"
snapshot py
key esc
wait text "Branch / tag"
