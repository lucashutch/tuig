# Right-click in the diff: the selected-lines menu on a changed line, the file menu on a context line.
fixture demo
wait text "Working Changes"
wait text "Unstage all"
click 60 4
click 118 6
wait text "handler_00"
click 30 6
click 30 6 right
wait text "Selected lines"
snapshot selected-lines
key esc
key esc
click 60 4 right
snapshot file-menu
key esc
snapshot closed
