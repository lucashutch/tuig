# Resize the terminal: smaller, larger, and back to 160x48. The footer notice from the commit click
# is masked, because it expires during the scenario.
fixture demo
wait text "Working Changes"
click 60 13
wait text "COMMIT FILES"
mask 100 47 60 1
resize 100 30
wait stable
snapshot small
resize 200 60
wait stable
snapshot large
resize 160 48
wait stable
snapshot back
resize 60 20
wait stable
snapshot tiny
