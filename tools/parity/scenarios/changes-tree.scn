# Changes pane: fold a folder, the file context menus for an unstaged, an untracked and a staged
# file, and fold a section by its heading.
fixture demo
wait text "Working Changes"
click 122 5
snapshot folder-folded
click 122 5
snapshot folder-unfolded
click 122 20
snapshot staged-folder-folded
click 122 20
snapshot staged-folder-unfolded
click 124 6 right
snapshot unstaged-menu
click 126 11
expect-clipboard "src/server.py"
snapshot copied-path
click 124 7 right
snapshot untracked-menu
key esc
click 124 23 right
snapshot staged-menu
key esc
click 122 4
snapshot unstaged-section-folded
click 122 6
snapshot staged-section-folded
