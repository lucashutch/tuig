# Diff line selection: an alt+drag range, ctrl+click to remove a line, and Esc to clear.
fixture demo
wait text "Working Changes"
click 60 4
wait text "Unstaged files"
click 118 6
wait text "handler_00"
drag 70 6 70 20 alt
snapshot range
click 33 6 left ctrl
snapshot line-removed
key esc
snapshot cleared
