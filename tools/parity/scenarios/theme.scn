# Theme picker from the command palette: list, preview with the arrow keys, select, then the mode list.
fixture demo
wait text "Working Changes"
key ctrl+p
text "theme"
snapshot filtered
key enter
wait text "Search themes"
snapshot themes
key down
snapshot preview
key enter
snapshot selected
key ctrl+p
text "mode"
key enter
wait text "Search modes"
snapshot modes
key down
key enter
snapshot light
