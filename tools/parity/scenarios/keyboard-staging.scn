# Pane keys: stage the selected file, stage all, switch to the staged section, unstage the selected
# file, then discard all with the confirmation.
fixture demo
wait text "Working Changes"
click 60 4
wait text "Unstaged files"
key tab
key s
snapshot stage-file
key a
snapshot stage-all
key t
snapshot staged-section
key u
snapshot unstage-file
key t
key d
snapshot discard-confirm
key d
snapshot discarded
