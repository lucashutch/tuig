# Fetch, pull and push from an ssh remote that refuses the key. The ssh stub fails unless git was
# started with BatchMode=yes, so a password prompt cannot hang the app. The footer shows the message.
fixture ssh-remote
stub ssh-denied
wait text "chore: initial commit"
click 53 1
wait text "needs credentials"
move 100 30
snapshot fetch-denied
click 62 1
wait text "Pull needs"
move 100 30
snapshot pull-denied
click 70 1
wait text "Push needs"
move 100 30
snapshot push-denied
