# Start with a saved session (two tabs, the second active) and a path on the command line: the path
# opens last and becomes the active tab. The recent list in the picker keeps its order.
fixture demo
extra second
restore
seed config/tuig/session.json '{"repositories":["{second}"],"activeRepository":"{second}","recentRepositories":["{second}","/nonexistent/old-project"]}'
wait text "Working Changes"
snapshot explicit-path
key ctrl+t
snapshot picker-recent
