# Start with a saved session and no path: the saved tabs open and the saved active tab shows.
fixture demo
extra second
restore
nopath
seed config/tuig/session.json '{"repositories":["{repo}","{second}"],"activeRepository":"{second}","recentRepositories":["{second}","{repo}"]}'
wait text "docs: extend notes"
move 140 40
snapshot restored
key ctrl+tab
# After a tab switch the selected row differs between the apps (checklist: tab history position). TS selects the
# Working Changes row (row 4), Rust selects the row below it. Only these two rows are masked.
mask 30 4 84 2
# The "Unstage all" button appears a moment after the tab shows, so wait for it.
wait text "Working Changes"
wait text "Unstage all"
move 140 40
snapshot other-tab
