# Wheel over the history list: down a little, down to the end of the loaded
# pages (which loads more), then back up to the top.
fixture history
wait text "add md sample"
snapshot top
wheel down 60 20 10
snapshot down-10
wheel down 60 20 300
snapshot bottom
wheel up 60 20 10
snapshot up-10
wheel up 60 20 300
snapshot back-at-top
