# Commit staged files, then undo the commit: the preview popup, a cancel, and the confirmed undo.
# The harness fixes the commit date, so the SHA is stable.
fixture demo
wait text "Working Changes"
click 150 3
key c
text "Throwaway"
key enter
wait stable
mask 0 47 160 1
ignore 130 1 30 1
click 79 1
wait text "Undo"
snapshot preview
key esc
snapshot cancelled
click 79 1
wait text "Undo"
key enter
wait stable
snapshot undone
