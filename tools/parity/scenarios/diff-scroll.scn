# A 151-line added file is taller than the diff pane. Wheel down and back up.
fixture history
# The footer shows a message for 6 s after a commit click, so its text depends on timing.
mask 0 47 160 1
wait text "add md sample"
click 60 17
wait text "COMMIT FILES"
click 118 18
wait text "step_000"
snapshot top
wheel down 60 20 10
snapshot down-10
wheel down 60 20 100
snapshot bottom
wheel up 60 20 5
snapshot up-5
wheel up 60 20 150
snapshot back-at-top
