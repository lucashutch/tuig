{
  "name": "tuig",
  "version": "0.1.0",
  "description": "A mouse-first Git client for the terminal",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucashutch/tuig.git"
  },
  "homepage": "https://github.com/lucashutch/tuig#readme",
  "bugs": "https://github.com/lucashutch/tuig/issues",
  "keywords": [
    "git",
    "terminal",
    "tui",
    "bun"
  ],
  "type": "module",
  "bin": {
    "tuig": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "bun run format:check && bun run typecheck && bun test"
  },
  "dependencies": {
    "@opentui/core": "0.5.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
